# Copy this file to .env and fill in real values. Never commit the real .env file.

# --- GitHub ---
# Fine-grained personal access token (or GitHub App installation token) with:
# Pull requests: Read & write, Issues: Read, Contents: Read on the target repo(s).
GITHUB_ACCESS_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Shared secret you choose when creating the webhook (Settings > Webhooks > Secret).
GITHUB_WEBHOOK_SECRET=choose-a-long-random-string

# --- OpenAI ---
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o

# --- SonarQube ---
# Generate from SonarQube > My Account > Security > Generate Token, after first login.
SONARQUBE_API_TOKEN=squ_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SONARQUBE_PROJECT_KEY=ai-augmented-code-review

# --- Postgres ---
POSTGRES_PASSWORD=choose-a-strong-password

# --- Demo safety net (see DEMO_SCRIPT.md) ---
# Set to true to auto-populate the dashboard with sample data on startup if the
# reviews table is empty. Leave false for normal use; flip to true before a demo
# as a fallback in case live GitHub/OpenAI/SonarQube calls aren't available.
DEMO_SEED_ON_STARTUP=false
